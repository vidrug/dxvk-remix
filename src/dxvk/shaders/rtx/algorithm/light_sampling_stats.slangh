/*
* Light sampling statistics.
*
* Wave-aggregated counters for the primary-surface NEE in the direct integrator, identical for every
* rtx.lightSampling.mode, so RTXDI and LightBVH frames can be compared on what the shadow rays actually do.
* rtx.lightSampling.logDirectStats enables them, and lightSamplingStatsAfterDirect (rtx_fork_light_bvh.cpp)
* reads them back and logs them as [LightSamplingStats]. The slot meanings must match that log line.
*/
#pragma once

static const uint kLightSamplingStatPixels = 0;          // primary pixels that ran NEE
static const uint kLightSamplingStatValid = 1;           // pixels with a valid light sample (shadow ray traced)
static const uint kLightSamplingStatDistant = 2;         // ... of which the light was distant (sun)
static const uint kLightSamplingStatOccluded = 3;        // shadow rays with an opaque hit
static const uint kLightSamplingStatOccludedDistant = 4; // ... of which distant
static const uint kLightSamplingStatCandidates = 5;      // non-opaque ray-query candidates processed (alpha/translucent any-hit work)
static const uint kLightSamplingStatWaves = 6;           // waves with at least one valid sample
static const uint kLightSamplingStatMixedWaves = 7;      // ... mixing distant and local lights
static const uint kLightSamplingStatUniformWaves = 8;    // ... where every valid lane sampled the same light
static const uint kLightSamplingStatLongRays = 9;        // shadow rays longer than 1000 world units
// What the cutout candidates did, over all visibility rays of the direct pass's primary NEE.
static const uint kLightSamplingStatAlphaCommits = 10;   // candidates that ended the ray as opaque (alpha test passed)
static const uint kLightSamplingStatPartialHits = 11;    // candidates with 0 < opacity < 1 (ray continues, attenuated)
// Primary pixels whose material takes the diffusion-profile subsurface path (its own probe, transmission and
// single-scattering rays on top of the NEE ray), so a frame's direct-pass time can be read against the SSS screen share.
static const uint kLightSamplingStatSssPixels = 12;
// rtx.shadowRays.contributionCutoff: local-light rays not traced, and what the dedicated sun / moon ray does.
static const uint kLightSamplingStatSkipped = 13;
static const uint kLightSamplingStatSunRays = 14;        // pixels with a sun or moon sample
static const uint kLightSamplingStatSunOccluded = 15;    // ... whose ray hit something
static const uint kLightSamplingStatSunCandidates = 16;  // non-opaque candidates of those rays
static const uint kLightSamplingStatSunSkipped = 17;     // ... whose ray was not traced
static const uint kLightSamplingStatSunRelativeSkips = 18; // local rays skipped only by the sun-relative test
// On 1 frame of 8, to keep the atomics out of the timing: how many local-light rays can add at most kContributionBucket[i]
// (display-linear), of all of them (Base) and of those that were not blocked (VisibleBase).
static const uint kLightSamplingStatContributionRays = 19;
static const uint kLightSamplingStatContributionBase = 20;
static const uint kLightSamplingStatContributionVisibleBase = 28;
static const uint kLightSamplingStatContributionBuckets = 8;
static const float kContributionBucket[8] = { 1e-5f, 3e-5f, 1e-4f, 3e-4f, 1e-3f, 3e-3f, 1e-2f, 3e-2f };
static const uint kLightSamplingStatCount = 36;


void lightSamplingStatsAdd(uint slot, uint value)
{
  const uint waveTotal = WaveActiveSum(value);
  if (WaveIsFirstLane() && waveTotal != 0u)
  {
    InterlockedAdd(LightSamplingStats[slot], waveTotal);
  }
}

// contribution: the most the local light could add (stored radiance). skipped: its ray was not traced; occluded counts a
// skipped ray as blocked, so with the cutoff off the visible counts are the rays a cutoff would change the image of.
void lightSamplingStatsRecordContribution(float contribution, bool skipped, bool sunRelativeSkip, bool occluded)
{
  lightSamplingStatsAdd(kLightSamplingStatSkipped, skipped ? 1u : 0u);
  lightSamplingStatsAdd(kLightSamplingStatSunRelativeSkips, sunRelativeSkip ? 1u : 0u);
  if ((cb.frameIdx & 7u) != 0u)
  {
    return;
  }
  InterlockedAdd(LightSamplingStats[kLightSamplingStatContributionRays], 1u);
  // The first bucket the contribution fits in. The log sums them up.
  const float display = contribution / max(cb.shadowRayDisplayToRadiance, 1e-30f);
  uint bucket = 0u;
  while (bucket < kLightSamplingStatContributionBuckets && display > kContributionBucket[bucket])
  {
    ++bucket;
  }
  if (bucket < kLightSamplingStatContributionBuckets)
  {
    InterlockedAdd(LightSamplingStats[kLightSamplingStatContributionBase + bucket], 1u);
    if (!occluded)
    {
      InterlockedAdd(LightSamplingStats[kLightSamplingStatContributionVisibleBase + bucket], 1u);
    }
  }
}

void lightSamplingStatsRecordPrimary(bool validSample, uint lightIdx, bool occluded, uint candidates, float rayLength,
                                     uint alphaCommits, uint partialHits)
{
  lightSamplingStatsAdd(kLightSamplingStatAlphaCommits, alphaCommits);
  lightSamplingStatsAdd(kLightSamplingStatPartialHits, partialHits);
  const LightRangeInfo distantRange = cb.lightRanges[lightTypeDistant];
  const bool distant = validSample && lightIdx >= distantRange.offset && lightIdx < distantRange.offset + distantRange.count;

  lightSamplingStatsAdd(kLightSamplingStatPixels, 1u);
  lightSamplingStatsAdd(kLightSamplingStatValid, validSample ? 1u : 0u);
  lightSamplingStatsAdd(kLightSamplingStatDistant, distant ? 1u : 0u);
  lightSamplingStatsAdd(kLightSamplingStatOccluded, (validSample && occluded) ? 1u : 0u);
  lightSamplingStatsAdd(kLightSamplingStatOccludedDistant, (distant && occluded) ? 1u : 0u);
  lightSamplingStatsAdd(kLightSamplingStatCandidates, candidates);
  lightSamplingStatsAdd(kLightSamplingStatLongRays, (validSample && rayLength > 1000.0f) ? 1u : 0u);

  const bool anyValid = WaveActiveAnyTrue(validSample);
  const bool anyDistant = WaveActiveAnyTrue(distant);
  const bool anyLocal = WaveActiveAnyTrue(validSample && !distant);
  // Invalid lanes do not break uniformity.
  const bool uniform = WaveActiveAllTrue(!validSample || lightIdx == WaveActiveMin(validSample ? lightIdx : 0xffffffffu));
  if (WaveIsFirstLane() && anyValid)
  {
    InterlockedAdd(LightSamplingStats[kLightSamplingStatWaves], 1u);
    if (anyDistant && anyLocal)
    {
      InterlockedAdd(LightSamplingStats[kLightSamplingStatMixedWaves], 1u);
    }
    if (uniform)
    {
      InterlockedAdd(LightSamplingStats[kLightSamplingStatUniformWaves], 1u);
    }
  }
}
